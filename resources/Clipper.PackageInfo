name clipper
version 1.0.0-1
architecture x86_64
summary "Clipboard history for air/OS and Haiku"
description "Clipper runs in the Deskbar and remembers text, rich text, images, and file references. Search or pin clips, restore every format, and paste back into the previous window. Tap Alt+V for ordinary paste; hold Alt+V or press Shift+Alt+V for history. Native input_server add-ons provide global shortcuts and paste injection."
packager "air/OS contributors"
vendor "air/OS"
copyrights { "2026 air/OS contributors" }
licenses { "MIT" }
provides {
    clipper = 1.0.0
    app:Clipper = 1.0.0
}
requires { haiku >= r1~beta5 }
